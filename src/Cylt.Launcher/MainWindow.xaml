<Window x:Class="Cylt.Launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CYLT Launcher" Width="1080" Height="760" MinWidth="960" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#F8FAF7" FontFamily="Microsoft YaHei UI" Loaded="OnLoaded" Closing="OnClosing">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#EEF3EE" BorderBrush="#DFE7DF" BorderThickness="0,0,1,0"><DockPanel Margin="18,30,18,24">
   <StackPanel DockPanel.Dock="Top" Margin="12,0,0,36"><Border Width="42" Height="42" CornerRadius="12" Background="#17654F" HorizontalAlignment="Left" Margin="0,0,0,15"><TextBlock Text="C" Foreground="White" FontWeight="Bold" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="CYLT" FontWeight="Bold" FontSize="25"/><TextBlock Text="LAUNCHER" FontSize="10" Foreground="#687B73" Margin="1,4,0,0"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="12,10,0,0"><TextBlock Text="0.1.0 · 开发预览" Style="{StaticResource MutedText}"/><TextBlock Text="为你的下一段旅程。" Style="{StaticResource MutedText}" Margin="0,7,0,0"/></StackPanel>
   <StackPanel><Button Style="{StaticResource Nav}" Content="⌂   开始游戏" Tag="Home" Click="Navigate"/><Button Style="{StaticResource Nav}" Content="◎   账号管理" Tag="Accounts" Click="Navigate"/><Button Style="{StaticResource Nav}" Content="▦   发现资源" Tag="Resources" Click="Navigate"/><Button Style="{StaticResource Nav}" Content="⚙   启动设置" Tag="Settings" Click="Navigate"/><Button Style="{StaticResource Nav}" Content="ⓘ   关于" Tag="About" Click="Navigate"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="34,30,34,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,24"><StackPanel><TextBlock x:Name="PageTitle" Text="开始游戏" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="选好版本，继续你的世界。" Style="{StaticResource MutedText}" Margin="0,7,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#E6EFE8" CornerRadius="20" Padding="13,7"><TextBlock x:Name="AccountBadge" Text="尚未选择账号" Foreground="#17654F" FontSize="12"/></Border></Grid>
   <Grid Grid.Row="1">
    <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Background="#173F32" CornerRadius="16" Height="172" Margin="0,0,0,22" ClipToBounds="True"><Grid>
      <Canvas HorizontalAlignment="Right" Width="310" Opacity="0.7"><Rectangle Canvas.Left="50" Canvas.Top="93" Width="74" Height="85" Fill="#366C53"/><Rectangle Canvas.Left="126" Canvas.Top="45" Width="62" Height="128" Fill="#528767"/><Rectangle Canvas.Left="190" Canvas.Top="110" Width="110" Height="63" Fill="#83AA7E"/><Rectangle Canvas.Left="225" Canvas.Top="27" Width="36" Height="36" Fill="#C1D5A6"/><Rectangle Canvas.Left="12" Canvas.Top="135" Width="38" Height="38" Fill="#2A5844"/></Canvas>
      <StackPanel Margin="28,27,0,0" VerticalAlignment="Top"><TextBlock Text="READY WHEN YOU ARE" Foreground="#AEC7B4" FontSize="10"/><TextBlock Text="世界很大，从这里出发。" Foreground="White" FontSize="23" FontWeight="SemiBold" Margin="0,16,0,11"/><TextBlock Text="一个简单、安静的 Minecraft 启动器。" Foreground="#C4D7C9" FontSize="12"/></StackPanel>
     </Grid></Border>
     <Border Style="{StaticResource Card}"><StackPanel>
      <Grid><TextBlock Text="游戏版本" FontSize="16" FontWeight="SemiBold"/><Button x:Name="RefreshButton" Content="刷新列表" HorizontalAlignment="Right" Padding="12,6" Click="RefreshVersions"/></Grid>
      <ComboBox x:Name="VersionBox" DisplayMemberPath="Caption" Margin="0,18,0,14" SelectionChanged="VersionChanged"/>
      <Grid Margin="0,0,0,22"><TextBlock x:Name="VersionHint" Style="{StaticResource MutedText}" Text="正在读取版本…"/><CheckBox x:Name="SnapshotCheck" Content="显示快照版" HorizontalAlignment="Right" Click="SnapshotChanged" FontSize="12"/></Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="LaunchButton" Content="开始游戏  →" Style="{StaticResource Primary}" FontSize="16" Height="50" Click="LaunchGame"/><Button x:Name="InstallButton" Grid.Column="1" Content="安装 / 修复" Margin="10,0,0,0" Click="InstallGame"/><Button Grid.Column="2" Content="游戏文件" Margin="10,0,0,0" Click="OpenGameFolder"/></Grid>
     </StackPanel></Border>
     <TextBlock x:Name="HomeHint" Text="首次游玩会下载游戏及所需 Java。请选择账号后启动。" Style="{StaticResource MutedText}" Margin="2,17,2,8"/>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="AccountsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TabControl Background="White" BorderBrush="#E1E8E1" Padding="24" SelectedIndex="1">
      <TabItem Header="微软正版"><StackPanel Margin="0,8,0,10"><TextBlock Text="使用你自己的微软账号" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="通过微软网页授权，启动器不会读取或保存微软密码。" Style="{StaticResource MutedText}" Margin="0,10,0,20"/><Button x:Name="MicrosoftLoginButton" Content="获取登录代码" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="MicrosoftLogin"/><TextBox x:Name="DeviceCodeBox" IsReadOnly="True" FontSize="25" FontWeight="SemiBold" TextAlignment="Center" Margin="0,20,0,10" Visibility="Collapsed"/><Button x:Name="MicrosoftWebButton" Content="打开微软登录网页" Visibility="Collapsed" Click="OpenMicrosoftLogin"/><TextBlock Text="当前应用尚未取得 Minecraft 服务接入许可。可进行微软授权，但游戏登录可能被服务方拒绝。" TextWrapping="Wrap" Foreground="#936326" Margin="0,20,0,0" FontSize="12"/></StackPanel></TabItem>
      <TabItem Header="离线账号"><StackPanel Margin="0,8,0,10"><TextBlock Text="从一个名字开始" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="离线游戏及支持该模式的服务器。无法连接要求正版验证的服务器。" Style="{StaticResource MutedText}" Margin="0,10,0,24"/><TextBlock Text="游戏名称" Margin="0,0,0,8"/><TextBox x:Name="OfflineNameBox" Text="Player" MaxLength="16"/><TextBlock Text="3–16 个英文字母、数字或下划线" Style="{StaticResource MutedText}" Margin="0,8,0,20"/><Button x:Name="OfflineButton" Content="使用这个账号" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="UseOffline"/></StackPanel></TabItem>
      <TabItem Header="第三方账号"><StackPanel Margin="0,6,0,10"><TextBlock Text="连接你的认证服务器" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="账号和密码将发送到下方地址，请确认它是你信任的服务。支持 Yggdrasil / authlib-injector。" Style="{StaticResource MutedText}" Margin="0,8,0,16"/><TextBlock Text="认证服务器根地址（HTTPS）" Margin="0,0,0,6"/><TextBox x:Name="ServerBox"/>
       <Grid Margin="0,13,0,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="账号 / 邮箱" Margin="0,0,0,6"/><TextBox x:Name="ThirdPartyUserBox"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="密码" Margin="0,0,0,6"/><PasswordBox x:Name="ThirdPartyPasswordBox"/></StackPanel></Grid>
       <Button x:Name="ThirdPartyLoginButton" Content="登录认证服务器" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="ThirdPartyLogin"/><StackPanel x:Name="ProfilePanel" Visibility="Collapsed" Margin="0,12,0,0"><TextBlock Text="选择游戏角色" Margin="0,0,0,6"/><ComboBox x:Name="ProfileBox" DisplayMemberPath="Name"/><Button Content="使用此角色" Margin="0,10,0,0" Click="UseThirdPartyProfile"/></StackPanel>
      </StackPanel></TabItem>
     </TabControl>
     <CheckBox x:Name="RememberAccountCheck" Content="记住账号（仅当前 Windows 用户可解密）" Margin="3,20,0,15" Click="RememberChanged"/><Border Style="{StaticResource Card}" Padding="18"><Grid><TextBlock x:Name="CurrentAccountText" Text="当前账号：未选择" VerticalAlignment="Center"/><Button Content="退出账号" HorizontalAlignment="Right" Padding="12,7" Click="ForgetAccount"/></Grid></Border>
    </StackPanel></ScrollViewer>
    <Grid x:Name="ResourcesPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="ResourceSourceBox" SelectedIndex="0"><ComboBoxItem Content="Modrinth"/><ComboBoxItem Content="CurseForge"/></ComboBox><TextBox x:Name="SearchBox" Grid.Column="1" Margin="10,0" KeyDown="SearchKeyDown" ToolTip="输入模组名称"/><Button x:Name="SearchButton" Grid.Column="2" Content="搜索" Style="{StaticResource Primary}" Click="SearchResources"/></Grid>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="搜索模组，前往项目页选择适合游戏版本和加载器的文件。" Style="{StaticResource MutedText}" Margin="0,0,0,14"/><ItemsControl x:Name="ResourceItems"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Author}" Style="{StaticResource MutedText}" Margin="0,5,0,6"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" MaxHeight="52" FontSize="12" Foreground="#687B73"/></StackPanel><Button Grid.Column="1" Content="项目页 ↗" Tag="{Binding Url}" VerticalAlignment="Center" Click="OpenResource"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
    </Grid>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="游戏与性能" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBlock Text="游戏文件夹" Margin="0,0,0,7"/><DockPanel><Button DockPanel.Dock="Right" Content="选择" Margin="8,0,0,0" Click="BrowseGameDirectory"/><TextBox x:Name="GamePathBox"/></DockPanel><TextBlock Text="Java 程序（留空则自动下载匹配版本）" Margin="0,17,0,7"/><DockPanel><Button DockPanel.Dock="Right" Content="选择" Margin="8,0,0,0" Click="BrowseJava"/><TextBox x:Name="JavaPathBox"/></DockPanel><TextBlock Text="最大内存（MB）" Margin="0,17,0,7"/><TextBox x:Name="MemoryBox" Text="4096" Width="160" HorizontalAlignment="Left"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,15,0,15"><StackPanel><TextBlock Text="服务接入" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,17"/><TextBlock Text="微软应用 Client ID" Margin="0,0,0,7"/><TextBox x:Name="ClientIdBox"/><TextBlock Text="CurseForge API Key" Margin="0,17,0,7"/><PasswordBox x:Name="CurseForgeKeyBox"/><TextBlock x:Name="KeyStatus" Text="尚未配置；留空保存时保留现有 Key。" Style="{StaticResource MutedText}" Margin="0,7,0,0"/><Button Content="清除已保存的 CurseForge Key" HorizontalAlignment="Left" Padding="10,6" Margin="0,10,0,0" Click="ForgetApiKey"/></StackPanel></Border><Button x:Name="SaveSettingsButton" Content="保存设置" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="SaveSettings" Margin="0,0,0,10"/>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="CYLT Launcher" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="0.1.0 · 独立开发预览版" Style="{StaticResource MutedText}" Margin="0,8,0,26"/><TextBlock Text="让启动游戏回归简单。" FontSize="19" Margin="0,0,0,15"/><TextBlock Text="独立编写的界面与业务代码。游戏安装和启动使用 CmlLib.Core；第三方认证使用 authlib-injector。感谢这些开源项目的贡献者。" TextWrapping="Wrap" LineHeight="24"/><TextBlock Text="本项目不是 Mojang、Microsoft 或其他启动器的官方产品。Minecraft 的名称、游戏与资源归其各自权利人所有。" Style="{StaticResource MutedText}" Margin="0,22,0,22"/><Button Content="查看开源许可" HorizontalAlignment="Left" Click="ShowLicenses"/></StackPanel></Border></ScrollViewer>
   </Grid>
   <Border Grid.Row="2" Background="#EFF3EE" CornerRadius="10" Margin="0,20,0,0" Padding="15,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusText" Text="准备就绪" TextWrapping="Wrap" FontSize="12"/><ProgressBar x:Name="TaskProgress" Height="4" Margin="0,9,0,0" Foreground="#17654F" Visibility="Collapsed" Maximum="1"/></StackPanel><Button x:Name="CancelButton" Grid.Column="1" Content="取消" Padding="12,6" Margin="12,0,0,0" Visibility="Collapsed" Click="CancelTask"/></Grid></Border>
  </Grid>
 </Grid>
</Window>
